{
  "name": "proharness",
  "version": "0.2.0",
  "private": true,
  "description": "A macOS desktop workbench for Oh My Pi: tabbed sessions, approvals, plans, diffs and a reviewed autonomous task loop.",
  "main": "./out/main/index.js",
  "author": {
    "name": "ProHarness",
    "email": "maintainers@proharness.dev"
  },
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:live": "PROHARNESS_LIVE=1 PROHARNESS_LIVE_LOOP=1 vitest run tests/omp-live.test.ts tests/loop-live.test.ts",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --arm64",
    "dist:dir": "npm run build && electron-builder --mac dir --arm64",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "0.15.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.19.0",
  "homepage": "https://github.com/Anshuman115/proharness"
}
